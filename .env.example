# Copy to apps/api/.env and adjust. Never commit real secrets.
# Docker compose Postgres uses port 5432; the embedded dev DB (npm run db:embedded) uses 5433.
DATABASE_URL=postgresql://rtm:rtm@localhost:5433/rtm?schema=public
TEST_DATABASE_URL=postgresql://rtm:rtm@localhost:5433/rtm_test?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=12h
PORT=3000
LOG_LEVEL=info

# Background jobs: pg (default, Postgres-backed) | bullmq (needs Redis) | inline (tests)
QUEUE_DRIVER=pg
REDIS_URL=redis://localhost:6379

# Demo conveniences — NEVER set in production (ignored when NODE_ENV=production):
# shows the current MFA code on the login screen so HQ/admin can be explored without an authenticator.
DEMO_MODE=1
# MFA for MANAGER/ADMIN is on unless this is 0.
MFA_REQUIRED=1

# Payments: leave the Razorpay keys empty to use the local mock gateway (same webhook path).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=mock-webhook-secret-for-local-dev
PAYMENT_INTENT_TTL_MS=900000

# GST / analytics knobs
EWB_THRESHOLD_PAISE=5000000
TARGET_COVER_DAYS=10
