{
  "name": "@rtm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --enable-source-maps -r @swc-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.6",
    "@prisma/client": "6.19.3",
    "@rtm/shared": "*",
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.7",
    "nestjs-pino": "4.4.0",
    "pino": "9.7.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@swc-node/register": "1.10.10",
    "@swc/core": "1.11.24",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.1",
    "@types/node": "22.15.3",
    "@types/supertest": "6.0.3",
    "pino-pretty": "13.0.0",
    "prisma": "6.19.3",
    "supertest": "7.1.0",
    "tsx": "4.19.4",
    "unplugin-swc": "1.5.5",
    "vitest": "3.2.4"
  }
}
